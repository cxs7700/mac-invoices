# Copy to .env at the repo root and fill in. A single root .env is loaded by both
# apps (the api resolves it via apps/api/src/lib/loadEnv.ts). See PROJECT_PLAN.md §13.

# --- API ---
# Matches the docker-compose Postgres service (user/pass/db = postgres/postgres/invoices).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invoices
NODE_ENV=development
SESSION_SECRET=change-me
# Allowed browser origin for CORS (the web dev server). credentials are enabled.
WEB_ORIGIN=http://localhost:5173
# The seeded landlord user. Until auth (Phase 3), the API sets invoice.userId to
# this id server-side on create; the seed creates the user with this id/email.
LANDLORD_USER_ID=landlord_seed_user
LANDLORD_EMAIL=landlord@example.com
# The landlord's login password (hashed at seed time). Set a STRONG, unique value
# in production — the seed refuses the dev default there.
LANDLORD_PASSWORD=changeme-dev
# Send the session cookie only over HTTPS. Set true on any non-localhost deploy.
COOKIE_SECURE=false

# --- Google Sheets (Phase 5) ---
# JSON string of a service-account key. Do NOT commit a real value.
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_SHEET_ID=

# --- Web ---
# Optional. The SPA calls the API with same-origin relative /api paths; in dev the
# Vite server proxies /api to the local API (vite.config.ts), and in the Vercel
# deploy /api is same-origin — so this is normally left EMPTY. Set it only to point
# the SPA at a non-same-origin API. See docs/DEPLOYMENT.md.
# VITE_API_URL=
