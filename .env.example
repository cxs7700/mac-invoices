# Copy to .env at the repo root and fill in. A single root .env is loaded by both
# apps (the api resolves it via apps/api/src/lib/loadEnv.ts). See PROJECT_PLAN.md §13.

# --- API ---
# Matches the docker-compose Postgres service (user/pass/db = postgres/postgres/invoices).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invoices
NODE_ENV=development
# Allowed browser origin for CORS (the web dev server). credentials are enabled.
WEB_ORIGIN=http://localhost:5173
# The seeded landlord user. Until auth (Phase 3), the API sets invoice.userId to
# this id server-side on create; the seed creates the user with this id/email.
LANDLORD_USER_ID=landlord_seed_user
LANDLORD_EMAIL=landlord@example.com
# The landlord's login password (hashed at seed time). Set a STRONG, unique value
# in production — the seed refuses the dev default there.
LANDLORD_PASSWORD=changeme-dev
# Send the session cookie only over HTTPS. Set true on any non-localhost deploy.
COOKIE_SECURE=false
# Shared invite code required to create an account at /login → Sign up. UNSET =
# signup is disabled entirely (the endpoint 503s), which is the default posture.
# Rotating it invalidates it for everyone — there are no per-invite codes.
SIGNUP_INVITE_CODE=
# REQUIRED. HMAC key from which every vendor submission link is derived, so the
# landlord can copy a vendor's link at any time instead of only when it is first
# minted (DEC-033). Use a random string of at least 32 chars, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Treat it as a secret: it is the only thing standing between a database dump
# and a working submission link. Changing it invalidates EVERY outstanding link.
VENDOR_LINK_KEY=

# --- Google Sheets (Phase 5) ---
# JSON string of a service-account key. Do NOT commit a real value. Share the
# target sheet as Editor with the key's client_email. See docs/DEPLOYMENT.md.
GOOGLE_SERVICE_ACCOUNT_KEY=
# GOOGLE_SHEET_ID removed — the export target is per-user (User.sheetSpreadsheetId,
# set once in Settings → Sheets); there is no server-side fallback.
# Tab the export appends to (default "Invoices"); write the header row there once.
GOOGLE_SHEET_TAB=Invoices
# Tuning knobs (safe defaults; usually unset). Export route rate-limit cap per
# window (default 5 / 15 min); rows per Sheets append call (default 500, clamped
# 1..500); retry backoff base ms (default 300, lowered in tests).
# EXPORT_RATE_LIMIT_MAX=5
# EXPORT_CHUNK_SIZE=500
# SHEETS_RETRY_BASE_MS=300

# --- Image storage (Vercel Blob) ---
# Auto-injected on a Vercel project with a Blob store linked. Required only to run
# the photo-capture feature live; tests mock the storage adapter. Free within the
# Vercel Blob Hobby allowance.
# BLOB_READ_WRITE_TOKEN=

# --- Web ---
# Optional. The SPA calls the API with same-origin relative /api paths; in dev the
# Vite server proxies /api to the local API (vite.config.ts), and in the Vercel
# deploy /api is same-origin — so this is normally left EMPTY. Set it only to point
# the SPA at a non-same-origin API. See docs/DEPLOYMENT.md.
# VITE_API_URL=

# --- Contractor notifications (landlord digest email + cron) ---
# Transactional email (Resend, free tier). RESEND_API_KEY enables sending; tests
# mock the email module so this is unset in CI. EMAIL_FROM is the sender — use
# onboarding@resend.dev for dev (no DNS), or a verified-domain address in prod.
# RESEND_API_KEY=
# EMAIL_FROM=onboarding@resend.dev
# Shared secret the digest-flush endpoint requires (Authorization: Bearer <secret>).
# The external scheduler (GitHub Actions) sends it; the endpoint fails closed if unset.
# Generate with: openssl rand -base64 32
# CRON_SECRET=
