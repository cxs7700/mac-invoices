generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  // Generic display name, kept in sync with firstName+lastName on every
  // profile write (`[firstName, lastName].filter(Boolean).join(' ')`). Read by
  // consumers that only need a display string (event actor names, the invoice
  // `user` embed) — they don't need the split and are unaffected by it.
  name         String?
  // Split name fields for the PDF Bill-To section and the editable profile
  // form. Nullable: pre-split users are backfilled by
  // `prisma/backfill-invoice-items.ts`; a user with no name has both null.
  firstName    String?
  lastName     String?
  role         Role         @default(LANDLORD)
  // Per-user Google Sheets export target — the only source for both the manual
  // "Sync now" export and continuous sync (the cron mirror). Null = no sheet
  // connected; there is no server-side fallback (removed — see DEC-029(i)).
  sheetSpreadsheetId String?
  // High-water mark for continuous Sheets sync: the last successful full mirror.
  // A user is "dirty" when their newest Invoice.updatedAt (or newest DELETED
  // event) is after this, which triggers a clear+rewrite of their sheet.
  sheetSyncedAt DateTime?
  // In-app notification read-state: vendor activity newer than this is
  // "unread". Cleared (set to now) when the landlord opens the notifications feed.
  notificationsSeenAt DateTime?
  // UI language preference (server source of truth, mirrored to localStorage).
  locale       String       @default("en")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  invoices     Invoice[]
  sessions     Session[]
  vendors      Vendor[]
  properties   Property[]

  @@map("users")
}

// A lightweight vendor the landlord collects invoices from via a no-login
// tokenized link. NOT a User: no password, no session. The link is a bearer
// credential — `tokenLookupId` is a non-secret indexed handle for a point
// lookup; `tokenHash` is the SHA-256 of the secret (never stored in plaintext,
// mirroring Session). `revokedAt` invalidates the link; regenerate overwrites
// the lookupId + hash. A vendor belongs to exactly one landlord (v1).
//
// `phone` and `email` are both nullable: the invoice-form auto-create path
// writes a name-only vendor. The "at least one contact" rule is enforced in
// Zod (CreateVendorSchema) for landlord-entered vendors only.
//
// A raw expression index — `UNIQUE ("landlordId", lower("name"))`, migration
// 20260807200000_vendor_unique_name_per_landlord — enforces case-insensitive
// per-landlord name uniqueness at the DB level, backing writeService's
// find-then-create auto-vendor path against a double-click/concurrent race.
// It is deliberately NOT modeled here as `@@unique([landlordId, name])`:
// Prisma's schema DSL can't express a `lower()` expression index, and a
// case-SENSITIVE `@@unique` would be a different constraint that puts this
// schema out of sync with the DB (which `migrate dev` would then try to
// "fix" by dropping the real index).
model Vendor {
  id            String    @id @default(cuid())
  landlordId    String
  landlord      User      @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  name          String
  phone         String?
  email         String?
  tokenLookupId String    @unique
  // The link secret is derived, never stored: HMAC(VENDOR_LINK_KEY,
  // tokenLookupId:tokenVersion). Bumping the version rotates the link; see
  // src/vendors/token.ts and DECISIONS.md DEC-034.
  tokenVersion  Int       @default(0)
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  submissions   Invoice[] @relation("InvoiceSubmittedByVendor")
  invoices      Invoice[] @relation("InvoiceVendor")

  @@index([landlordId])
  @@map("vendors")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Invoice {
  id                     String           @id @default(cuid())
  // Nullable: vendor submissions are created before a number is assigned.
  // The sequential number is stamped on the first APPROVED transition (KTD-11)
  // so withdrawn/rejected submissions never leave gaps in the landlord's ledger.
  // Sequential per OWNER, not globally: see @@unique([userId, invoiceNumber])
  // below. Nullable because a contractor submission carries no number until it
  // is approved (KTD-11); Postgres treats NULLs as never-equal, so a user may
  // hold many unnumbered invoices at once.
  invoiceNumber          String?
  vendorName             String
  vendorEmail            String?
  // Server-computed sum of `items[].total`, recomputed inside the same
  // transaction that writes the items — never accepted as client input.
  amount                 Decimal          @db.Decimal(10, 2)
  currency               String           @default("USD")
  // Nullable: a vendor submission carries no category — the landlord sets
  // it on review (APPROVED is blocked until it is set).
  category               InvoiceCategory?
  // The property this invoice is assigned to, if any. Optional at create/submit,
  // required to APPROVE (enforced in writeService, not the DB). Restrict so a
  // property with invoices can't be deleted out from under its spend history —
  // the API pre-checks and returns a friendly count first.
  propertyId             String?
  property               Property?        @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  status                 InvoiceStatus    @default(PENDING)
  invoiceDate            DateTime
  paidDate               DateTime?
  rejectionReason        String?
  notes                  String?
  // Free-text description of parts ordered for the job (optional).
  partsOrdered           String?
  sheetsSyncedAt         DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  userId                 String
  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The vendor who submitted this invoice, if any. The invoice is still
  // owned by the landlord (`userId`); this only records the submitter, AND it
  // is the authorization scope for that vendor's no-login link (see
  // submissions/handlers.ts). SetNull so deleting a vendor never cascades into
  // the landlord's owned invoice.
  submittedByVendorId    String?
  submittedByVendor      Vendor?          @relation("InvoiceSubmittedByVendor", fields: [submittedByVendorId], references: [id], onDelete: SetNull)
  // Attribution: which vendor this invoice is FROM. Set by the invoice form's
  // picker or by auto-create. Deliberately separate from submittedByVendorId —
  // sharing one column would let a vendor's public link read landlord-entered
  // invoices merely attributed to them.
  vendorId               String?
  vendor                 Vendor?          @relation("InvoiceVendor", fields: [vendorId], references: [id], onDelete: SetNull)
  images                 InvoiceImage[]
  items                  InvoiceItem[]

  @@index([userId, status])
  @@index([userId, invoiceDate])
  @@index([submittedByVendorId])
  @@index([vendorId])
  @@index([propertyId])
  // Per-tenant numbering: two landlords may each hold invoice "1". A global
  // unique here would leak across tenants — a collision with ANOTHER user's
  // number returned 409, which is a working existence oracle (DEC-029(j)).
  @@unique([userId, invoiceNumber])
  @@map("invoices")
}

// A landlord's rental property. Invoices are assigned to a property to organize
// spend. Per-landlord (landlordId); mirrors the Vendor entity.
model Property {
  id         String   @id @default(cuid())
  landlordId String
  landlord   User     @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  name       String
  address    String
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  invoices   Invoice[]

  @@index([landlordId])
  @@map("properties")
}

// One itemized line on an invoice (description, quantity, total). `total` is
// entered directly — quantity is informational and does not multiply a unit
// price (there is no price field). `sortOrder` preserves entry order since
// items have no other natural ordering. The invoice's `amount` is the
// server-computed sum of its items' totals (see Invoice.amount).
model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  total       Decimal  @db.Decimal(10, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_items")
}

// Photos associated with an invoice (e.g. cash, parts, or check). The actual
// upload pipeline (presigned S3/R2) and viewing UI are a later phase; this models
// the relation so the schema is ready and `url` references stored objects.
model InvoiceImage {
  id        String    @id @default(cuid())
  invoiceId String
  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  url       String
  type      ImageType @default(OTHER)
  caption   String?
  createdAt DateTime  @default(now())

  @@index([invoiceId])
  @@map("invoice_images")
}

// Append-only ledger of meaningful invoice changes (creation, status
// transitions, money-field edits, deletion). The materialized Invoice row stays
// the source of truth; this is the history of how it got there.
//
// `invoiceId` is intentionally a plain column with NO relation/foreign key: a
// DELETED event must outlive its invoice (the snapshot in `detail` is the
// archive), so the row must NOT cascade-delete with the invoice. `actorId` is
// who caused the event; `ownerUserId` is the invoice owner and the read-scoping
// key (a future vendor can author an event the landlord still owns/reads).
model InvoiceEvent {
  id          String    @id @default(cuid())
  invoiceId   String
  actorId     String
  ownerUserId String
  type        EventType
  detail      Json
  source      String    @default("RECORDED")
  // When this event was swept into a landlord digest email (null = un-notified).
  // The flush stamps it after a successful send (at-least-once); not a new event.
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([invoiceId])
  @@index([ownerUserId, createdAt])
  @@map("invoice_events")
}

enum EventType {
  CREATED
  STATUS_CHANGED
  FIELD_EDITED
  DELETED
  IMAGE_ATTACHED
  IMAGE_REMOVED
}

enum Role {
  LANDLORD
  VENDOR
  ADMIN
}

enum ImageType {
  CASH
  PARTS
  CHECK
  OTHER
}

enum InvoiceStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  CANCELLED
  // Entry state for a vendor-submitted invoice, awaiting landlord review.
  SUBMITTED
}

enum InvoiceCategory {
  MAINTENANCE
  REPAIRS
  UTILITIES
  SUPPLIES
  LABOR
  OTHER
}
