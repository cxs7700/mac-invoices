generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         Role      @default(LANDLORD)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  invoices     Invoice[]
  sessions     Session[]

  @@map("users")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Invoice {
  id             String          @id @default(cuid())
  invoiceNumber  String          @unique
  vendorName     String
  vendorEmail    String?
  description    String
  amount         Decimal         @db.Decimal(10, 2)
  currency       String          @default("USD")
  category       InvoiceCategory
  propertyId     String?
  status         InvoiceStatus   @default(PENDING)
  invoiceDate    DateTime
  dueDate        DateTime?
  paidDate       DateTime?
  notes          String?
  attachmentUrl  String?
  sheetsSyncedAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  images         InvoiceImage[]

  @@index([userId, status])
  @@index([userId, invoiceDate])
  @@map("invoices")
}

// Photos associated with an invoice (e.g. cash, parts, or check). The actual
// upload pipeline (presigned S3/R2) and viewing UI are a later phase; this models
// the relation so the schema is ready and `url` references stored objects.
model InvoiceImage {
  id        String    @id @default(cuid())
  invoiceId String
  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  url       String
  type      ImageType @default(OTHER)
  caption   String?
  createdAt DateTime  @default(now())

  @@index([invoiceId])
  @@map("invoice_images")
}

// Append-only ledger of meaningful invoice changes (creation, status
// transitions, money-field edits, deletion). The materialized Invoice row stays
// the source of truth; this is the history of how it got there.
//
// `invoiceId` is intentionally a plain column with NO relation/foreign key: a
// DELETED event must outlive its invoice (the snapshot in `detail` is the
// archive), so the row must NOT cascade-delete with the invoice. `actorId` is
// who caused the event; `ownerUserId` is the invoice owner and the read-scoping
// key (a future contractor can author an event the landlord still owns/reads).
model InvoiceEvent {
  id          String    @id @default(cuid())
  invoiceId   String
  actorId     String
  ownerUserId String
  type        EventType
  detail      Json
  source      String    @default("RECORDED")
  createdAt   DateTime  @default(now())

  @@index([invoiceId])
  @@index([ownerUserId, createdAt])
  @@map("invoice_events")
}

enum EventType {
  CREATED
  STATUS_CHANGED
  FIELD_EDITED
  DELETED
}

enum Role {
  LANDLORD
  CONTRACTOR
  ADMIN
}

enum ImageType {
  CASH
  PARTS
  CHECK
  OTHER
}

enum InvoiceStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  CANCELLED
}

enum InvoiceCategory {
  MAINTENANCE
  REPAIRS
  UTILITIES
  SUPPLIES
  LABOR
  OTHER
}
