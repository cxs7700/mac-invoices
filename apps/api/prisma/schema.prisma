generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String?
  role         Role         @default(LANDLORD)
  // Per-landlord Google Sheets export target; the export prefers this over the
  // GOOGLE_SHEET_ID env default. Null = use the env default.
  sheetSpreadsheetId String?
  // In-app notification read-state: contractor activity newer than this is
  // "unread". Cleared (set to now) when the landlord opens the notifications feed.
  notificationsSeenAt DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  invoices     Invoice[]
  sessions     Session[]
  contractors  Contractor[]

  @@map("users")
}

// A lightweight contractor the landlord collects invoices from via a no-login
// tokenized link. NOT a User: no password, no session. The link is a bearer
// credential — `tokenLookupId` is a non-secret indexed handle for a point
// lookup; `tokenHash` is the SHA-256 of the secret (never stored in plaintext,
// mirroring Session). `revokedAt` invalidates the link; regenerate overwrites
// the lookupId + hash. A contractor belongs to exactly one landlord (v1).
model Contractor {
  id            String    @id @default(cuid())
  landlordId    String
  landlord      User      @relation(fields: [landlordId], references: [id], onDelete: Cascade)
  name          String
  contact       String
  tokenLookupId String    @unique
  tokenHash     String
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  submissions   Invoice[]

  @@index([landlordId])
  @@map("contractors")
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Invoice {
  id                     String           @id @default(cuid())
  // Nullable: contractor submissions are created before a number is assigned.
  // The sequential number is stamped on the first APPROVED transition (KTD-11)
  // so withdrawn/rejected submissions never leave gaps in the landlord's ledger.
  invoiceNumber          String?          @unique
  vendorName             String
  vendorEmail            String?
  description            String
  amount                 Decimal          @db.Decimal(10, 2)
  currency               String           @default("USD")
  // Nullable: a contractor submission carries no category — the landlord sets
  // it on review (APPROVED is blocked until it is set).
  category               InvoiceCategory?
  propertyId             String?
  status                 InvoiceStatus    @default(PENDING)
  invoiceDate            DateTime
  dueDate                DateTime?
  paidDate               DateTime?
  rejectionReason        String?
  notes                  String?
  attachmentUrl          String?
  sheetsSyncedAt         DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  userId                 String
  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The contractor who submitted this invoice, if any. The invoice is still
  // owned by the landlord (`userId`); this only records the submitter. SetNull
  // so deleting a contractor never cascades into the landlord's owned invoice.
  submittedByContractorId String?
  submittedByContractor   Contractor?     @relation(fields: [submittedByContractorId], references: [id], onDelete: SetNull)
  images                 InvoiceImage[]

  @@index([userId, status])
  @@index([userId, invoiceDate])
  @@index([submittedByContractorId])
  @@map("invoices")
}

// Photos associated with an invoice (e.g. cash, parts, or check). The actual
// upload pipeline (presigned S3/R2) and viewing UI are a later phase; this models
// the relation so the schema is ready and `url` references stored objects.
model InvoiceImage {
  id        String    @id @default(cuid())
  invoiceId String
  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  url       String
  type      ImageType @default(OTHER)
  caption   String?
  createdAt DateTime  @default(now())

  @@index([invoiceId])
  @@map("invoice_images")
}

// Append-only ledger of meaningful invoice changes (creation, status
// transitions, money-field edits, deletion). The materialized Invoice row stays
// the source of truth; this is the history of how it got there.
//
// `invoiceId` is intentionally a plain column with NO relation/foreign key: a
// DELETED event must outlive its invoice (the snapshot in `detail` is the
// archive), so the row must NOT cascade-delete with the invoice. `actorId` is
// who caused the event; `ownerUserId` is the invoice owner and the read-scoping
// key (a future contractor can author an event the landlord still owns/reads).
model InvoiceEvent {
  id          String    @id @default(cuid())
  invoiceId   String
  actorId     String
  ownerUserId String
  type        EventType
  detail      Json
  source      String    @default("RECORDED")
  // When this event was swept into a landlord digest email (null = un-notified).
  // The flush stamps it after a successful send (at-least-once); not a new event.
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([invoiceId])
  @@index([ownerUserId, createdAt])
  @@map("invoice_events")
}

enum EventType {
  CREATED
  STATUS_CHANGED
  FIELD_EDITED
  DELETED
  IMAGE_ATTACHED
  IMAGE_REMOVED
}

enum Role {
  LANDLORD
  CONTRACTOR
  ADMIN
}

enum ImageType {
  CASH
  PARTS
  CHECK
  OTHER
}

enum InvoiceStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  CANCELLED
  // Entry state for a contractor-submitted invoice, awaiting landlord review.
  SUBMITTED
}

enum InvoiceCategory {
  MAINTENANCE
  REPAIRS
  UTILITIES
  SUPPLIES
  LABOR
  OTHER
}
