{
  "name": "mac-invoices",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run dev -w @mac-invoices/web",
    "dev:web": "npm run dev -w @mac-invoices/web",
    "dev:api": "npm run dev -w @mac-invoices/api",
    "build": "npm run build -w @mac-invoices/web",
    "start": "npm run start -w @mac-invoices/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck -w @mac-invoices/shared && npm run typecheck -w @mac-invoices/api && npm run typecheck -w @mac-invoices/web",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w @mac-invoices/api",
    "db:push": "npm run db:push -w @mac-invoices/api",
    "db:migrate": "npm run db:migrate -w @mac-invoices/api",
    "db:deploy": "npm run db:deploy -w @mac-invoices/api",
    "db:reset": "npm run db:reset -w @mac-invoices/api",
    "db:seed": "npm run db:seed -w @mac-invoices/api",
    "db:backfill-events": "npm run db:backfill-events -w @mac-invoices/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@vercel/nft": "^1.10.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.4.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
