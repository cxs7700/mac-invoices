generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  name          String?
  invoices      Invoice[]
}

model Invoice {
  id            Int       @id @default(autoincrement())
  description   String
  date          DateTime
  location      String
  price         Decimal
  status        String
  number        Int       @unique
  quantity      Int?    
  creatorId     Int
  creator       User      @relation(fields: [creatorId], references: [id])
}
